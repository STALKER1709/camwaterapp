# Copiez ce fichier en « .env » et adaptez les valeurs.
# Toutes les variables sont facultatives sauf ANTHROPIC_API_KEY.

# --- Authentification du modèle ---------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Modèle de lecture visuelle ---------------------------------------------
CAMWATER_MODEL=claude-opus-5
CAMWATER_EFFORT=high            # low | medium | high | xhigh | max
CAMWATER_MAX_TOKENS=32000
CAMWATER_LLM_RETRIES=3

# --- Serveur ------------------------------------------------------------------
CAMWATER_HOST=0.0.0.0
CAMWATER_PORT=8000
CAMWATER_LOG_LEVEL=INFO

# --- Fichiers et dossiers -----------------------------------------------------
# CAMWATER_DATA_DIR=/srv/camwater/data
# CAMWATER_INBOX_DIR=/mnt/partage/factures
CAMWATER_EXCEL_FILENAME=CAMWATER_Pointage_General.xlsx
CAMWATER_MAX_UPLOAD_MB=50
CAMWATER_PDF_DPI=200
CAMWATER_MAX_PAGES=40

# --- Règles métier ------------------------------------------------------------
CAMWATER_PRIX_UNITAIRE=382
CAMWATER_TAUX_TVA=0.1925
CAMWATER_TOLERANCE=1            # écart toléré, en FCFA, sur les totaux
CAMWATER_REJETER_DOUBLONS=true

# Feuille unique au lieu d'une feuille par administration (laisser vide pour
# ventiler par ministère) :
# CAMWATER_FEUILLE_UNIQUE=Pointage

# Règles de mapping ministère supplémentaires (fichier JSON) :
# CAMWATER_MAPPING_FILE=./mapping_overrides.json

# Faire figurer les mois sans facture dans la feuille Résumé (état MANQUANTE) :
CAMWATER_COMPLETER_MOIS=true
